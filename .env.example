# Copia como .env y elige una contraseña local. No subas .env a Git.
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5433
# Para ejecutar el backend desde el host:
DB_URL=jdbc:postgresql://localhost:5433/ica_stay
DB_USER=ica_stay
# Backend en el host: ruta absoluta persistente FUERA del repositorio.
# Si se omite, usa ${user.home}/.icastay/photos. No almacenar en /tmp.
# PHOTO_STORAGE_ROOT=D:/IcaStayData/photos
# FFmpeg existente, utilizado para validar WebP por decodificacion real.
# PHOTO_WEBP_DECODER=C:/ruta/a/ffmpeg.exe
